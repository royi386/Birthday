DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LAN_BIND_ADDRESS=0.0.0.0
OFFICE_TIME_ZONE=Asia/Kolkata
OFFICE_NAME=Your Office
BIRTHDAY_GREETING=Many many happy returns of the day!
BIRTHDAY_SLIDE_SECONDS=10
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_PATH=/data/db.sqlite3
# For PostgreSQL, set DATABASE_ENGINE=django.db.backends.postgresql and configure:
POSTGRES_DB=odds
POSTGRES_USER=odds
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MEDIA_ROOT=/media
BACKUP_INTERVAL_SECONDS=86400
CSRF_TRUSTED_ORIGINS=
